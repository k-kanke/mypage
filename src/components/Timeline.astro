---
const { items, title, locale = 'ja' } = Astro.props;

const formatRange = (item) => {
	if (item.to && item.to !== '') {
		return `${item.from} – ${item.to === 'present' ? (locale === 'ja' ? '現在' : 'Present') : item.to}`;
	}
	return item.from;
};
---

<section class="card timeline">
	<h2>{title}</h2>
	<ol class="timeline-list">
		{items.map((item) => (
			<li>
				<div class="timeline-axis" aria-hidden="true"><span></span></div>
				<div class="experience-body">
					<div class="experience-heading">
                        <h3>{item.title}</h3>
                    </div>
					<div class="experience-meta">
						<time>{formatRange(item)}</time>
						{item.role ? <span class="experience-role">{item.role}</span> : null}
					</div>
					{item.Content ? <item.Content /> : <p>{item.description}</p>}
					{item.tags?.length ? (
						<div class="tag-list" role="list">
							{item.tags.map((tag) => (
								<span class="tag" role="listitem">{tag}</span>
							))}
						</div>
					) : null}
				</div>
			</li>
		))}
	</ol>
</section>

<style>
 .timeline-list { list-style: none; margin: 0; padding: 0; width: 88%; }
 .timeline-list > li { display: grid; grid-template-columns: 12px minmax(0, 1fr); column-gap: 24px; align-items: stretch; padding: 0; }
 .timeline-axis { grid-column: 1; grid-row: 1; position: relative; }
 .timeline-axis::before { content: ''; position: absolute; left: 5px; top: 22px; bottom: -22px; width: 2px; background: #777777; }
 .timeline-axis > span { position: absolute; left: 0; top: 16px; width: 12px; height: 12px; border-radius: 50%; background: #333333; }
 .timeline-list > li:last-child .timeline-axis::before { display: none; }
 .timeline-list > li:last-child .experience-body { margin-bottom: 0; }
 time { font-family: monospace; font-size: 12px; font-weight: 600; color: #444444; white-space: nowrap; }
 .experience-body { grid-column: 2; grid-row: 1; min-width: 0; margin-bottom: 10px; overflow-wrap: anywhere; padding: 8px 12px; line-height: 1.5; border: 2px solid #999999; border-radius: 12px; background: transparent; }
 .experience-meta { display: flex; flex-direction: column; align-items: flex-start; gap: 1px; margin-bottom: 4px; }
 .experience-role { font-size: 15px; font-weight: 500; color: #333333; }
 .tag-list { gap: 2px 10px; margin-top: 4px; }
 .tag { font-size: 13px; font-weight: 500; color: #444444; }
 .experience-heading { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; margin-bottom: 2px; }
 h3 { margin: 0; font-size: 20px; font-weight: 600; line-height: 1.35; }
 .timeline-list :global(p), .timeline-list :global(ul) { margin: 0 0 4px; font-size: 13px; color: #656565; line-height: 1.6; }
 .timeline-list :global(ul) { padding-left: 20px; }
 .timeline-list :global(blockquote) { margin: 4px 0; padding-left: 12px; border-left: 2px solid #c7c7c7; }
 .experience-body > :global(:last-child) { margin-bottom: 0; }
 @media (max-width: 640px) {
  .timeline-list { width: 100%; }
  .timeline-list > li { column-gap: 16px; }
  .experience-body { padding: 8px 10px; }
 }
</style>
