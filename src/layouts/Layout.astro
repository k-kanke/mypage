---
const { lang, meta, switcherLabel, languageName } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={meta.description} />
		<title>{meta.title}</title>
	</head>
	<body>
		<header class="site-header">
			<nav class="language-switcher" aria-label={switcherLabel}>
				<a href="../ja/" aria-current={lang === 'ja' ? 'page' : undefined}>{languageName.ja}</a>
				<span>/</span>
				<a href="../en/" aria-current={lang === 'en' ? 'page' : undefined}>{languageName.en}</a>
			</nav>
		</header>
		<slot />
	</body>
</html>

<style>

 :global(*) { box-sizing: border-box; }
 :global(html) { background: #ffffff; scroll-behavior: smooth; }
 :global(body) { margin: 0; background: #ffffff; color: #242424; font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'Noto Sans JP', sans-serif; font-size: 14px; line-height: 1.8; -webkit-font-smoothing: antialiased; }
 :global(a) { color: inherit; text-underline-offset: 4px; }
 :global(a:hover) { color: #575757; }
 :global(:focus-visible) { outline: 2px solid #575757; outline-offset: 5px; }
 :global(::selection) { background: #dadada; }
 .site-header { position: sticky; top: 0; z-index: 100; background: #ffffff; padding: 12px max(40px, calc((100% - 920px) / 2)); display: flex; justify-content: flex-end; align-items: center; border-bottom: 1px solid #d6d6d6; }
 .language-switcher { display: flex; align-items: center; gap: 14px; font-size: 11px; }
 .language-switcher a { text-decoration: none; color: #717171; padding: 6px 0; }
 .language-switcher a[aria-current='page'] { color: #242424; text-decoration: underline; }
 .language-switcher span { color: #b3b3b3; }
 :global(.card) { padding-top: 28px; border-top: 1px solid #a2a2a2; }
 :global(.card > h2) { margin: 0 0 34px; font-size: clamp(26px, 4vw, 32px); font-weight: 600; letter-spacing: -.025em; line-height: 1.3; display: flex; align-items: center; gap: 16px; }
 :global(.tag-list) { display: flex; flex-wrap: wrap; gap: 6px 14px; }
 :global(.tag) { color: #6a6a6a; font-size: 10px; letter-spacing: .02em; }
 @media (max-width: 640px) { .site-header { padding: 8px 24px; } }
 @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }

</style>
